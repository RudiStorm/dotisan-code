<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dotisan.Cli</AssemblyName>
    <RootNamespace>Dotisan.Cli</RootNamespace>
    <PackageId>Dotisan</PackageId>
    <ToolCommandName>dotisan</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <Version>0.8.6</Version>
    <Authors>Dotisan contributors</Authors>
    <RepositoryUrl>https://github.com/RudiStorm/dotisan-code</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/RudiStorm/dotisan-code</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/RudiStorm/dotisan-code/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>dotisan.svg</PackageIcon>
    <PackageTags>dotnet;aspnetcore;scaffolding;cli;vue;typescript;openapi</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>Dotisan application scaffolding CLI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dotisan.Core\Dotisan.Core.csproj" />
    <ProjectReference Include="..\Dotisan.Generators\Dotisan.Generators.csproj" />
    <ProjectReference Include="..\Dotisan.TypeScript\Dotisan.TypeScript.csproj" />
    <ProjectReference Include="..\Dotisan.OpenApi\Dotisan.OpenApi.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\..\assets\dotisan.svg" Pack="true" PackagePath="dotisan.svg" />
  </ItemGroup>
</Project>
