import { afterEach, describe, expect, it, vi } from 'vitest';
import { request } from './client';

describe('request', () => {
  afterEach(() => vi.unstubAllGlobals());

  it('does not request an antiforgery token for plain projects', async () => {
    const fetchMock = vi.fn().mockResolvedValueOnce(new Response(JSON.stringify({ ok: true }), { status: 200 }));
    vi.stubGlobal('fetch', fetchMock);

    await expect(request<{ ok: boolean }>('/api/example', { method: 'POST', body: '{}' })).resolves.toEqual({ ok: true });
    expect(fetchMock).toHaveBeenCalledTimes(1);
    expect(fetchMock).toHaveBeenCalledWith('/api/example', expect.objectContaining({ credentials: 'include' }));
  });
});
