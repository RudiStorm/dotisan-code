FROM node:22-alpine AS web-build
WORKDIR /src
COPY src/__PROJECT_NAME__.Web/package*.json ./
RUN npm ci
COPY src/__PROJECT_NAME__.Web/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api-build
WORKDIR /src
COPY Directory.Packages.props ./
COPY src/__PROJECT_NAME__.Api/__PROJECT_NAME__.Api.csproj src/__PROJECT_NAME__.Api/
RUN dotnet restore src/__PROJECT_NAME__.Api/__PROJECT_NAME__.Api.csproj
COPY . .
COPY --from=web-build /src/dist src/__PROJECT_NAME__.Api/wwwroot
RUN dotnet publish src/__PROJECT_NAME__.Api/__PROJECT_NAME__.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app
COPY --from=api-build /app/publish .
RUN mkdir -p /app/Data && chown $APP_UID /app/Data
USER $APP_UID
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget --spider --no-verbose http://localhost:8080/api/health || exit 1
ENTRYPOINT ["dotnet", "__PROJECT_NAME__.Api.dll"]
